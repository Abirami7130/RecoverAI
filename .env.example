# RecoverAI environment variables (copy to .env.local and fill in)

# SQLite database (dev)
DATABASE_URL="file:./dev.db"

# Razorpay test keys (never use NEXT_PUBLIC_ for secrets)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Set to true in tests or when Razorpay keys are absent for local API tests
RAZORPAY_USE_FAKE="false"

# FastAPI ML service
FASTAPI_URL="http://localhost:8000"

# Background recovery worker (optional in dev)
RECOVERY_WORKER_ENABLED="false"
WORKER_SECRET=""
INTERNAL_WORKER_BASE_URL=""

# Auth (Phase 4)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_VIEWER_EMAIL=""
SEED_VIEWER_PASSWORD=""
